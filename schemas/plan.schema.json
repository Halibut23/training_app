{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Weekly training plan",
  "type": "object",
  "required": [
    "week",
    "start_date",
    "end_date",
    "revision",
    "status",
    "created",
    "phase",
    "adjustment_type",
    "focus",
    "targets",
    "rationale",
    "sessions",
    "revision_history"
  ],
  "additionalProperties": false,
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "completed"
      ]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "phase": {
      "type": "string"
    },
    "adjustment_type": {
      "enum": [
        "progression",
        "hold",
        "deload",
        "replacement",
        "restructure"
      ]
    },
    "focus": {
      "type": "string"
    },
    "targets": {
      "type": "object",
      "required": [
        "hours"
      ],
      "additionalProperties": false,
      "properties": {
        "hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "bike_hours": {
          "type": "number",
          "minimum": 0
        },
        "run_km": {
          "type": "number",
          "minimum": 0
        },
        "strength_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "est_tss": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "rationale": {
      "type": "object",
      "required": [
        "summary",
        "rules_applied"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "data_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules_applied": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^R-[A-Z]+-[0-9]{2}$"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "revision",
          "date",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "placement_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Constraints for reordering sessions (R-GEN-11/12). Session dates are suggestions."
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "items": {
        "type": [
          "number",
          "null"
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "step": {
      "type": "object",
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "duration_min": {
          "type": "number",
          "minimum": 0
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "recovery_min": {
          "type": "number",
          "minimum": 0
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "power_w": {
              "$ref": "#/$defs/range"
            },
            "hr_max_bpm": {
              "type": "number"
            },
            "pace_min_km": {
              "$ref": "#/$defs/range"
            },
            "rpe": {
              "$ref": "#/$defs/range"
            },
            "cadence_rpm": {
              "$ref": "#/$defs/range"
            }
          }
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "id",
        "date",
        "sport",
        "session_type",
        "title",
        "priority",
        "duration_min",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "sport": {
          "enum": [
            "bike",
            "run",
            "strength",
            "rest",
            "other"
          ]
        },
        "session_type": {
          "enum": [
            "bike_recovery",
            "bike_z2",
            "bike_long",
            "bike_tempo",
            "bike_sweetspot",
            "bike_threshold",
            "bike_vo2",
            "bike_test",
            "run_easy",
            "run_quality",
            "run_long",
            "strength",
            "rest",
            "other"
          ]
        },
        "title": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "key",
            "supporting",
            "optional"
          ]
        },
        "environment": {
          "enum": [
            "indoor",
            "outdoor",
            "either"
          ]
        },
        "duration_min": {
          "type": "number",
          "minimum": 0
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "est_tss": {
          "type": "number",
          "minimum": 0
        },
        "structure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "purpose": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "done",
            "modified",
            "missed",
            "replaced"
          ]
        },
        "actual_activity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed_date": {
          "type": "string",
          "format": "date",
          "description": "Actual date when done; may lie before the plan week if the athlete moved it earlier."
        }
      }
    }
  }
}
