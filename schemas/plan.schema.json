{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Weekly training plan",
  "type": "object",
  "required": [
    "week",
    "start_date",
    "end_date",
    "revision",
    "status",
    "created",
    "phase",
    "adjustment_type",
    "focus",
    "targets",
    "rationale",
    "sessions",
    "revision_history"
  ],
  "additionalProperties": false,
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "completed"
      ]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "phase": {
      "type": "string"
    },
    "adjustment_type": {
      "enum": [
        "progression",
        "hold",
        "deload",
        "replacement",
        "restructure"
      ]
    },
    "focus": {
      "type": "string"
    },
    "targets": {
      "type": "object",
      "required": [
        "hours"
      ],
      "additionalProperties": false,
      "properties": {
        "hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "bike_hours": {
          "type": "number",
          "minimum": 0
        },
        "run_km": {
          "type": "number",
          "minimum": 0
        },
        "strength_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "est_tss": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "rationale": {
      "type": "object",
      "required": [
        "summary",
        "rules_applied"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "data_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules_applied": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^R-[A-Z]+-[0-9]{2}$"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "revision",
          "date",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "placement_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Constraints for reordering sessions (R-GEN-11/12). Session dates are suggestions."
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "items": {
        "type": [
          "number",
          "null"
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "step": {
      "type": "object",
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "reps": {
          "type": "integer",
          "minimum": 1
        },
        "duration_min": {
          "type": "number",
          "minimum": 0
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "recovery_min": {
          "type": "number",
          "minimum": 0
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "kind": {
          "enum": [
            "warmup",
            "interval",
            "recovery",
            "rest",
            "cooldown",
            "other"
          ],
          "description": "Garmin step type (D-022). Default: with >= 2 top-level steps the first is warmup and the last cooldown; all others interval."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1,
          "description": "Sub-steps. With reps > 1 they form a Garmin repeat group; without reps they are inlined (e.g. warm-up with openers). R-WO-01."
        },
        "recovery_target": {
          "$ref": "#/$defs/target",
          "description": "Target for the recovery_min shorthand step."
        },
        "notes": {
          "type": "string",
          "description": "Short cue shown on the watch/head unit for this step."
        },
        "lap_button": {
          "type": "boolean",
          "description": "Step ends on lap press instead of time/distance."
        },
        "garmin_target": {
          "enum": [
            "power",
            "pace",
            "hr",
            "cadence",
            "none"
          ],
          "description": "Override the primary Garmin target for this step (default per R-WO-04)."
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "id",
        "date",
        "sport",
        "session_type",
        "title",
        "priority",
        "duration_min",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "sport": {
          "enum": [
            "bike",
            "run",
            "strength",
            "rest",
            "other"
          ]
        },
        "session_type": {
          "enum": [
            "bike_recovery",
            "bike_z2",
            "bike_long",
            "bike_tempo",
            "bike_sweetspot",
            "bike_threshold",
            "bike_vo2",
            "bike_test",
            "run_easy",
            "run_quality",
            "run_long",
            "strength",
            "rest",
            "other"
          ]
        },
        "title": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "key",
            "supporting",
            "optional"
          ]
        },
        "environment": {
          "enum": [
            "indoor",
            "outdoor",
            "either"
          ]
        },
        "duration_min": {
          "type": "number",
          "minimum": 0
        },
        "distance_km": {
          "type": "number",
          "minimum": 0
        },
        "est_tss": {
          "type": "number",
          "minimum": 0
        },
        "structure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "purpose": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        },
        "status": {
          "enum": [
            "planned",
            "done",
            "modified",
            "missed",
            "replaced"
          ]
        },
        "actual_activity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed_date": {
          "type": "string",
          "format": "date",
          "description": "Actual date when done; may lie before the plan week if the athlete moved it earlier."
        },
        "erg": {
          "type": "boolean",
          "description": "Bike only: trainer in ERG mode (true) or free riding (false). Required to push bike sessions (R-WO-02)."
        },
        "garmin_push": {
          "type": "boolean",
          "description": "false = never push this session to Garmin. Default: bike/run sessions with structure are pushed."
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "power_w": {
          "$ref": "#/$defs/range"
        },
        "hr_max_bpm": {
          "type": "number"
        },
        "pace_min_km": {
          "$ref": "#/$defs/range"
        },
        "rpe": {
          "$ref": "#/$defs/range"
        },
        "cadence_rpm": {
          "$ref": "#/$defs/range"
        }
      }
    }
  }
}
