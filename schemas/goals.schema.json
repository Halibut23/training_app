{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goals.schema.json",
  "title": "Athlete goals",
  "type": "object",
  "required": ["as_of", "goals"],
  "properties": {
    "as_of": {"type": "string", "format": "date"},
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sport", "priority", "title", "status", "history"],
        "properties": {
          "id": {"type": "string", "pattern": "^G-[A-Z0-9-]+$"},
          "sport": {"enum": ["bike", "run", "strength", "all"]},
          "horizon": {"enum": ["short", "medium", "long", "ongoing"]},
          "priority": {"type": "integer", "minimum": 1},
          "title": {"type": "string"},
          "metric": {"type": "object"},
          "deadline": {"type": ["string", "null"], "format": "date"},
          "status": {"enum": ["active", "achieved", "dropped", "paused"]},
          "note": {"type": "string"},
          "test_protocol": {"type": "string"},
          "history": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["date", "change"]}}
        }
      }
    }
  }
}
