{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkin.schema.json",
  "title": "Weekly subjective check-in",
  "type": "object",
  "required": [
    "week",
    "created"
  ],
  "additionalProperties": false,
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "knee": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "green",
              "yellow",
              "red"
            ]
          },
          "next_morning": {
            "enum": [
              "green",
              "yellow",
              "red",
              null
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "activity_id": {
            "type": "string"
          },
          "sport": {
            "enum": [
              "bike",
              "run",
              "strength",
              "other"
            ]
          },
          "rpe": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          },
          "session_type_override": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "hr_sensor": {
            "enum": [
              "strap",
              "wrist",
              "none"
            ],
            "description": "HR source for the session (DESIGN C-M7). Wrist HR is low-confidence for short hard intervals and steep climbs."
          }
        }
      }
    },
    "strength": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "duration_min"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "duration_min": {
            "type": "number",
            "minimum": 0
          },
          "rpe": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "general": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fatigue_1_5": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "sleep_note": {
          "type": "string"
        },
        "stress_note": {
          "type": "string"
        },
        "illness": {
          "type": "boolean"
        }
      }
    },
    "goal_changes": {
      "type": "string"
    },
    "constraints_next_week": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  }
}
